# Сборочные каталоги контракта. artifacts/ воспроизводим из Cargo.lock:
# cosmwasm/optimizer собирает его побитово одинаково.
protocol/contract/target/
protocol/contract/artifacts/

# Эталонный cw20_base для девнета — скачивается из релиза cw-plus,
# в репозитории ему делать нечего.
protocol/devnet/cw20_base.wasm

# Учёт шлюза: остатки клиентов и прочитанная высота. Состояние рабочей
# установки, а не код.
gateway-ledger.json
gateway/*.json
live-ledger.json

__pycache__/
*.pyc

# Сделка загрузки кода: в ней лежит тот же артефакт в base64, то есть она
# так же воспроизводима и так же не нужна в репозитории. Пересобирается
# одной командой из РАЗВЁРТЫВАНИЕ.md.
protocol/contract/deploy/unsigned/1-store-unsigned.json

# То же для контракта-пробника со стенда Axiome: артефакт воспроизводим
# из его Cargo.lock тем же cosmwasm/optimizer.
research/axiome-devnet/stargate-probe/target/
research/axiome-devnet/stargate-probe/target-native/
research/axiome-devnet/stargate-probe/artifacts/

# Каталог сборки стенда: клон узла и его Dockerfile, воспроизводимо.
research/axiome-devnet/.stand/
