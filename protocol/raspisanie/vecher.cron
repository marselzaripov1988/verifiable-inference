# /etc/cron.d/vecher — часы сети 19:00–20:00 по Москве.
# Сервер в UTC, а cron Ubuntu CRON_TZ не понимает: время пересчитано
# вручную. Москва — UTC+3 круглый год, перевода часов нет.
#
#   15:40 UTC = 18:40 МСК  проверить баланс и поднять (новая машина — 7–10 мин)
#   17:00 UTC = 20:00 МСК  дождаться закрытия заданий и уничтожить машины
#   17:30 UTC = 20:30 МСК  страховка: уничтожить без ожидания
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
VECHER_HOME=/opt/vecher

40 15 * * * root flock -n /run/vecher-up.lock /opt/vecher/vecher.py up >> /var/log/vecher.log 2>&1
0 17 * * * root flock -w 1500 /run/vecher-down.lock /opt/vecher/vecher.py down >> /var/log/vecher.log 2>&1
30 17 * * * root flock -w 600 /run/vecher-down.lock /opt/vecher/vecher.py down --no-drain >> /var/log/vecher.log 2>&1
